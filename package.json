{
  "name": "obsidian-scenery",
  "version": "0.6.0",
  "description": "Wallpaper Engine-like animated wallpapers for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node test/run.mjs && node test/studio.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "studio": "node studio/build.mjs",
    "studio:dev": "node studio/build.mjs --serve"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "obsidian": "latest",
    "playwright": "^1.63.0",
    "typescript": "^5.4.0"
  }
}
